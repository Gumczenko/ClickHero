{
  "name": "clickhero",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.1.2",
    "@types/react": "~19.0.10",
    "expo": "~54.0.0",
    "expo-haptics": "~14.1.4",
    "expo-linking": "~8.0.12",
    "expo-router": "~5.1.11",
    "expo-status-bar": "~2.2.3",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-web": "^0.20.0",
    "typescript": "~5.8.3"
